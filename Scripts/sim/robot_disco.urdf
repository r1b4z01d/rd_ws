      <plugin filename="libgazebo_ros_ray_sensor.so" name="velodyne_controller">
        <ros>
          <argument>~/out:=scan</argument>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>velodyne_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
