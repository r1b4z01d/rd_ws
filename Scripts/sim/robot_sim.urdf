  <joint name="ur_wrist_2_joint" type="revolute"><parent link="ur_wrist_1_link"/><child link="ur_wrist_2_link"/><origin xyz="0 -0.0997 0" rpy="1.570796 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.14"/></joint>
