  <link name="camera_link_optical" />

  <!-- ===== UR5e stick figure (ur_description kinematics, primitive visuals) + AmazingHand box, mounted
       like ur_mount.xacro: platform on the rear RPLiDAR, UR base 30 mm above it, yaw +90 deg. Replaced by
       the real model when Scripts/sim/robot_disco.urdf exists (sim/fetch_assets.sh). ===== -->
  <material name="ur_gray"><color rgba="0.75 0.77 0.8 1"/></material>
  <material name="ur_dark"><color rgba="0.25 0.27 0.3 1"/></material>
  <link name="ur_platform">
    <visual><geometry><box size="0.18 0.18 0.006"/></geometry><material name="gray"/></visual>
  </link>
  <joint name="ur_platform_joint" type="fixed"><parent link="rp_s2e_lidar"/><child link="ur_platform"/><origin xyz="0 0 0.015" rpy="0 0 0"/></joint>
  <link name="ur_base_link">
    <visual><origin xyz="0 0 0.03"/><geometry><cylinder length="0.06" radius="0.075"/></geometry><material name="ur_dark"/></visual>
  </link>
  <joint name="ur_base_joint" type="fixed"><parent link="rp_s2e_lidar"/><child link="ur_base_link"/><origin xyz="0 0 0.03" rpy="0 0 1.570796"/></joint>
  <link name="ur_base_link_inertia"/>
  <joint name="ur_base_link-base_link_inertia" type="fixed"><parent link="ur_base_link"/><child link="ur_base_link_inertia"/><origin xyz="0 0 0" rpy="0 0 3.141593"/></joint>
  <link name="ur_shoulder_link">
    <visual><geometry><cylinder length="0.13" radius="0.06"/></geometry><material name="ur_gray"/></visual>
    <visual><origin xyz="0 0 0.0" rpy="1.570796 0 0"/><geometry><cylinder length="0.14" radius="0.055"/></geometry><material name="ur_gray"/></visual>
  </link>
  <joint name="ur_shoulder_pan_joint" type="revolute"><parent link="ur_base_link_inertia"/><child link="ur_shoulder_link"/><origin xyz="0 0 0.1625" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.14"/></joint>
  <link name="ur_upper_arm_link">
    <visual><origin xyz="0 0 0.069"/><geometry><cylinder length="0.138" radius="0.055"/></geometry><material name="ur_gray"/></visual>
    <visual><origin xyz="-0.2125 0 0.138" rpy="0 1.570796 0"/><geometry><cylinder length="0.425" radius="0.05"/></geometry><material name="ur_gray"/></visual>
    <visual><origin xyz="-0.425 0 0.138"/><geometry><sphere radius="0.05"/></geometry><material name="ur_dark"/></visual>
  </link>
  <joint name="ur_shoulder_lift_joint" type="revolute"><parent link="ur_shoulder_link"/><child link="ur_upper_arm_link"/><origin xyz="0 0 0" rpy="1.570796 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.14"/></joint>
  <link name="ur_forearm_link">
    <visual><origin xyz="0 0 0.0725"/><geometry><cylinder length="0.131" radius="0.045"/></geometry><material name="ur_gray"/></visual>
    <visual><origin xyz="-0.1961 0 0.007" rpy="0 1.570796 0"/><geometry><cylinder length="0.3922" radius="0.04"/></geometry><material name="ur_gray"/></visual>
    <visual><origin xyz="-0.3922 0 0.007"/><geometry><sphere radius="0.04"/></geometry><material name="ur_dark"/></visual>
  </link>
  <joint name="ur_elbow_joint" type="revolute"><parent link="ur_upper_arm_link"/><child link="ur_forearm_link"/><origin xyz="-0.425 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-3.1416" upper="3.1416" effort="150" velocity="3.14"/></joint>
  <link name="ur_wrist_1_link">
    <visual><origin xyz="0 0 -0.0633"/><geometry><cylinder length="0.1266" radius="0.038"/></geometry><material name="ur_gray"/></visual>
    <visual><geometry><sphere radius="0.042"/></geometry><material name="ur_dark"/></visual>
  </link>
  <joint name="ur_wrist_1_joint" type="revolute"><parent link="ur_forearm_link"/><child link="ur_wrist_1_link"/><origin xyz="-0.3922 0 0.1333" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.14"/></joint>
  <link name="ur_wrist_2_link">
