# Robot Disco robot PC device permissions. Installed by provision.sh phase "udev" to /etc/udev/rules.d/.
# Serial devices (RoboClaw on /dev/ttyACM0, RPLiDAR on /dev/ttyUSB0) are covered by the dialout group.

# 3Dconnexion SpaceMouse. VLA's teleop uses the `hidapi` pip package (hid.device API), whose Linux
# wheel uses the LIBUSB backend: it opens the USB device node, so that needs the permission too.
SUBSYSTEM=="usb", ATTRS{idVendor}=="256f", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="256f", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c62*", MODE="0666", TAG+="uaccess"

# Intel RealSense (D435 0b07, D435i 0b3a, D405 0b5b, T265 0b37) — subset of librealsense's
# 99-realsense-libusb.rules; the full upstream file is preferable if available.
SUBSYSTEM=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07|0b3a|0b5b|0b37|0ad1|0ad2|0ad3|0ad4|0ad5|0b03|0b48|0b4b|0b4d|0b64|0b5c", MODE:="0666", GROUP:="plugdev"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="8086", MODE:="0666", GROUP:="plugdev"

# USB webcams used by the VLA camera service (scene / wrist / side)
SUBSYSTEM=="video4linux", GROUP="video", MODE="0660"

# Elgato Stream Deck (VLA capture/eval buttons). The python `streamdeck` library uses hidapi's
# LIBUSB backend, which opens the USB device node (/dev/bus/usb/...) and detaches hid-generic
# itself, so the usb node needs the permission, not only hidraw.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fd9", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0fd9", MODE="0666", TAG+="uaccess"

# Xbox / generic gamepads for joy_node and VLA evdev teleop
SUBSYSTEM=="input", GROUP="input", MODE="0660"

# Fallback for the STOCK xpad only: the rebuilt module from provision/xpad has the ID in its table
# (and sends the LED command the receiver needs before it streams); with it this rule is a no-op.
# 8BitDo Ultimate 2C (2.4 GHz receiver) in X-input mode enumerates as 2dc8:310a with an Xbox 360
# class interface (255/93/1). Kernels before 6.10 do not list that ID in xpad, so without this rule it
# sits unbound and joy_node sees no /dev/input/js0 (the Jetson's 5.15 kernel, 2026-10-10). Writing
# the ID to xpad's new_id makes the driver claim it; writing it again on re-pair is harmless.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="2dc8", ATTR{idProduct}=="310a", \
  RUN+="/bin/sh -c '/sbin/modprobe xpad; echo 2dc8 310a > /sys/bus/usb/drivers/xpad/new_id'"
