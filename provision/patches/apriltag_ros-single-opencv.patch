+// 8-bit grey from the usual encodings, done with the one OpenCV this library links against.
+//
+// This used to be cv_bridge::toCvShare(msg, "mono8"). On a Jetson (JetPack 6) the apt
+// ros-humble-cv-bridge and image_geometry are built against Ubuntu's OpenCV 4.5.4 while
+// find_package(OpenCV) resolves to NVIDIA's 4.8.0, so the component loaded two OpenCV runtimes
+// and the cv::Mat cv_bridge handed back aborted the container with
+// "OpenCV(4.8.0) ... error: (-215:Assertion failed) s >= 0 in function 'setSize'"
+// (robotdisco, 2026-11-01). Converting here keeps a single OpenCV in the process.
+static bool toMono8(const sensor_msgs::msg::Image & msg, cv::Mat & mono)
+{
+  const int h = static_cast<int>(msg.height);
+  const int w = static_cast<int>(msg.width);
+  const size_t step = msg.step;
+  if (h <= 0 || w <= 0 || step == 0 || msg.data.size() < step * msg.height) {
+    return false;
+  }
+  // The input Mats are views of the message buffer; the message outlives this call.
+  uint8_t * data = const_cast<uint8_t *>(msg.data.data());
+  const std::string & enc = msg.encoding;
+  if (enc == "mono8" || enc == "8UC1") {
+    mono = cv::Mat(h, w, CV_8UC1, data, step);       // view, no copy (as toCvShare did)
+  } else if (enc == "mono16" || enc == "16UC1") {
+    cv::Mat(h, w, CV_16UC1, data, step).convertTo(mono, CV_8U, 1.0 / 256.0);
+  } else if (enc == "rgb8") {
+    cv::cvtColor(cv::Mat(h, w, CV_8UC3, data, step), mono, cv::COLOR_RGB2GRAY);
+  } else if (enc == "bgr8") {
+    cv::cvtColor(cv::Mat(h, w, CV_8UC3, data, step), mono, cv::COLOR_BGR2GRAY);
+  } else if (enc == "rgba8") {
+    cv::cvtColor(cv::Mat(h, w, CV_8UC4, data, step), mono, cv::COLOR_RGBA2GRAY);
+  } else if (enc == "bgra8") {
+    cv::cvtColor(cv::Mat(h, w, CV_8UC4, data, step), mono, cv::COLOR_BGRA2GRAY);
+  } else if (enc == "yuv422_yuy2") {
+    cv::cvtColor(cv::Mat(h, w, CV_8UC2, data, step), mono, cv::COLOR_YUV2GRAY_YUY2);
+  } else if (enc == "yuv422") {
+    cv::cvtColor(cv::Mat(h, w, CV_8UC2, data, step), mono, cv::COLOR_YUV2GRAY_UYVY);
+  } else {
+    return false;
+  }
+  return true;
+}
